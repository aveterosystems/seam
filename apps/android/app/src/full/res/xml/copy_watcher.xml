<?xml version="1.0" encoding="utf-8"?>
<!-- No window content: Seam only checks events for Android's "Copied" confirmation or a Copy tap (CopyWatcher) -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewClicked|typeNotificationStateChanged|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/copy_watcher_description"
    android:notificationTimeout="0" />
